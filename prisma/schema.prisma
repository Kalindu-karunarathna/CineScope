
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------------
// ENUMS
// -------------------------

enum InteractionType {
  DETAILS_VIEW
  SEARCH_RESULT_CLICK
  TRAILER_CLICK
  RECOMMENDATION_CLICK
}

enum UserRole {
  USER
  ADMIN
}

// -------------------------
// USER
// -------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)

  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]
  ratings       Rating[]
  watchHistory  WatchHistory[]
  interactions  MovieInteraction[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// -------------------------
// AUTHENTICATION
// Compatible with Auth.js Prisma Adapter
// -------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------
// MOVIE
// -------------------------

model Movie {
  id               String   @id @default(cuid())
  tmdbId           Int      @unique

  title            String
  originalTitle    String?
  overview         String?  @db.Text

  posterPath       String?
  backdropPath     String?

  releaseDate      DateTime? @db.Date
  originalLanguage String?

  genreIds         Int[]    @default([])

  voteAverage      Float?
  popularity       Float?

  favorites        Favorite[]
  ratings          Rating[]
  watchHistory     WatchHistory[]
  interactions     MovieInteraction[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// -------------------------
// FAVORITES
// -------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  movieId   String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, movieId])
  @@index([movieId])
}

// -------------------------
// RATINGS
// -------------------------

model Rating {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  score     Int

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, movieId])
  @@index([movieId])
}

// -------------------------
// WATCH HISTORY
// -------------------------

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  watchedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, movieId])
  @@index([movieId])
}

// -------------------------
// MOVIE INTERACTIONS
// -------------------------

model MovieInteraction {
  id        String          @id @default(cuid())
  userId    String
  movieId   String
  type      InteractionType

  source    String?
  metadata  Json?

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)

  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([movieId, type])
}
